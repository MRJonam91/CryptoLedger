{
  "name": "cryptoledger",
  "version": "1.0.0",
  "description": "Local-first cryptocurrency transaction reconciler: reconstruct movements between exchanges and wallets, reconcile internal transfers with provenance, and isolate economic transactions with zero third-party leakage.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/CryptoLedger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/CryptoLedger.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/CryptoLedger/issues"
  },
  "keywords": [
    "crypto",
    "cryptocurrency",
    "reconciliation",
    "accounting",
    "ledger",
    "bitcoin",
    "ethereum",
    "local-first",
    "privacy",
    "provenance",
    "cli",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "cryptoledger": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "README.it.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "node src/cli/index.ts data/samples/exchange_alpha.csv data/samples/wallet_ledger.csv"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mrjonam"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/mrjonam"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/manorollo"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.7.3"
  }
}
